+"""Every pre-defined SILMA voice."""
+
+ENGLISH_VOICES: frozenset[str] = frozenset({"james", "emma"})
+ARABIC_VOICES: frozenset[str] = frozenset(
+    {"sarah", "salma", "salwa", "saja", "sultan", "salman", "sulaiman", "salim"}
