from typing import Final, TypedDict

class Host: ...

class Stats(TypedDict):
    values: int
    handles: int
    references: int
    async_work: int
    finalizers: int
    predictions: int
    vad_contexts: int
    calls: tuple[str, ...]

VAD_WINDOW_SAMPLES: Final[int]
MAX_VAD_CONTEXTS: Final[int]
PARENT_LOST_EXIT_CODE: Final[int]

def start_parent_watch(fd: int, /) -> None: ...
def stop_parent_watch() -> None: ...
def open(path: str, /) -> Host: ...
def init_eot(host: Host, /) -> None: ...
def predict_eot(host: Host, pcm: memoryview, /) -> float: ...
def init_vad(host: Host, /) -> None: ...
def create_vad(host: Host, /) -> int: ...
def predict_vad(host: Host, token: int, pcm: memoryview, /) -> float: ...
def reset_vad(host: Host, token: int, /) -> None: ...
def drop_vad(host: Host, token: int, /) -> None: ...
def stats(host: Host, /) -> Stats: ...
def close(host: Host, /) -> None: ...
