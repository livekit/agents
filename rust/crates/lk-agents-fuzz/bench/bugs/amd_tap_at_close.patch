--- a/rust/crates/lk-agents-voice/src/generation/pipeline_reply.rs
+++ b/rust/crates/lk-agents-voice/src/generation/pipeline_reply.rs
@@ -355,7 +355,9 @@ async fn follow_up(
 }
 
