# LiveKit (required) — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# OpenAI (required for STT + LLM + default TTS)
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Optional: HeadTTS REST (when set, used instead of OpenAI TTS)
# HEADTTS_URL=http://127.0.0.1:8882
# HEADTTS_VOICE=af_bella
# HEADTTS_LANGUAGE=en-us

# AiTwin auth (required) — browser assets + agent /avatar_alignVisemes
# From aitwin.me dashboard → API Keys (Client-Id + Client-Secret)
AITWIN_CLIENT_ID=your_client_id
AITWIN_CLIENT_SECRET=your_client_secret
AITWIN_TWIN_ID=victoria
# Production: https://ai.aitwin.me — Local testing: http://127.0.0.1:4000
AITWIN_API_BASE=https://ai.aitwin.me
AITWIN_AUTH_TOKEN_URL=https://us-central1-streamoji-265f4.cloudfunctions.net/getAiTwinAuthToken
AITWIN_ALIGN_LANGUAGE=en
# AITWIN_ALIGN_G2P_ONLY=true
# Cartesia engine id → oculus_direct viseme profile in the SDK
AITWIN_VISEME_ENGINE_ID=eng_c9b1e6d4

# Token server / agent
TOKEN_SERVER_PORT=8080
AGENT_NAME=aitwin-voice-assistant
TOPIC_SPEECH=aitwin.speech
TOPIC_SAY=aitwin.say
TOPIC_CHAT=lk.chat
