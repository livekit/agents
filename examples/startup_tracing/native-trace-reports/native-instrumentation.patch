+/// Emit sanitized timestamps for a temporary publication diagnostic build.
+fn publication_trace(name: &str, fields: &str) {
+    if std::env::var_os("LIVEKIT_PUBLICATION_TRACE").is_none() {
+        return;
+    }
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_micros() as f64
+        / 1000.0;
+    log::info!(target: "publication_trace", "{{\"name\":\"{}\",\"at_ms\":{},\"fields\":{}}}", name, now, fields);
+}
