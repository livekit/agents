import numpy as np
from numpy.typing import NDArray

class OpusStreamReader:
    def __init__(self, sample_rate: int, flush_every_n_samples: int = 0) -> None: ...
    def append_bytes(self, data: bytes) -> NDArray[np.float32]: ...

class OpusStreamWriter:
    def __init__(self, sample_rate: int) -> None: ...
    def append_pcm(self, pcm: NDArray[np.float32]) -> bytes: ...
