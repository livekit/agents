{
  "$ref": "#/$defs/AgentCard",
  "$defs": {
    "AgentCard": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "supportedInterfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentInterface"
          }
        },
        "provider": {
          "$ref": "#/$defs/AgentProvider"
        },
        "version": {
          "type": "string"
        },
        "documentationUrl": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/AgentCapabilities"
        },
        "securitySchemes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SecurityScheme"
          }
        },
        "securityRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecurityRequirement"
          }
        },
        "defaultInputModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultOutputModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentSkill"
          }
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentCardSignature"
          }
        },
        "iconUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "supportedInterfaces",
        "version",
        "capabilities",
        "defaultInputModes",
        "defaultOutputModes",
        "skills"
      ]
    },
    "AgentInterface": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "protocolBinding": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "protocolBinding",
        "protocolVersion"
      ]
    },
    "AgentProvider": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "organization"
      ]
    },
    "AgentCapabilities": {
      "type": "object",
      "properties": {
        "streaming": {
          "type": "boolean"
        },
        "pushNotifications": {
          "type": "boolean"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentExtension"
          }
        },
        "extendedAgentCard": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "AgentExtension": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "SecurityScheme": {
      "type": "object",
      "properties": {
        "apiKeySecurityScheme": {
          "$ref": "#/$defs/APIKeySecurityScheme"
        },
        "httpAuthSecurityScheme": {
          "$ref": "#/$defs/HTTPAuthSecurityScheme"
        },
        "oauth2SecurityScheme": {
          "$ref": "#/$defs/OAuth2SecurityScheme"
        },
        "openIdConnectSecurityScheme": {
          "$ref": "#/$defs/OpenIdConnectSecurityScheme"
        },
        "mtlsSecurityScheme": {
          "$ref": "#/$defs/MutualTlsSecurityScheme"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "apiKeySecurityScheme"
              ]
            },
            {
              "required": [
                "httpAuthSecurityScheme"
              ]
            },
            {
              "required": [
                "oauth2SecurityScheme"
              ]
            },
            {
              "required": [
                "openIdConnectSecurityScheme"
              ]
            },
            {
              "required": [
                "mtlsSecurityScheme"
              ]
            }
          ]
        }
      ]
    },
    "APIKeySecurityScheme": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "location",
        "name"
      ]
    },
    "HTTPAuthSecurityScheme": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "bearerFormat": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "scheme"
      ]
    },
    "OAuth2SecurityScheme": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "flows": {
          "$ref": "#/$defs/OAuthFlows"
        },
        "oauth2MetadataUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "flows"
      ]
    },
    "OAuthFlows": {
      "type": "object",
      "properties": {
        "authorizationCode": {
          "$ref": "#/$defs/AuthorizationCodeOAuthFlow"
        },
        "clientCredentials": {
          "$ref": "#/$defs/ClientCredentialsOAuthFlow"
        },
        "implicit": {
          "$ref": "#/$defs/ImplicitOAuthFlow"
        },
        "password": {
          "$ref": "#/$defs/PasswordOAuthFlow"
        },
        "deviceCode": {
          "$ref": "#/$defs/DeviceCodeOAuthFlow"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "authorizationCode"
              ]
            },
            {
              "required": [
                "clientCredentials"
              ]
            },
            {
              "required": [
                "implicit"
              ]
            },
            {
              "required": [
                "password"
              ]
            },
            {
              "required": [
                "deviceCode"
              ]
            }
          ]
        }
      ]
    },
    "AuthorizationCodeOAuthFlow": {
      "type": "object",
      "properties": {
        "authorizationUrl": {
          "type": "string"
        },
        "tokenUrl": {
          "type": "string"
        },
        "refreshUrl": {
          "type": "string"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pkceRequired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "authorizationUrl",
        "tokenUrl",
        "scopes"
      ]
    },
    "ClientCredentialsOAuthFlow": {
      "type": "object",
      "properties": {
        "tokenUrl": {
          "type": "string"
        },
        "refreshUrl": {
          "type": "string"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tokenUrl",
        "scopes"
      ]
    },
    "ImplicitOAuthFlow": {
      "type": "object",
      "properties": {
        "authorizationUrl": {
          "type": "string"
        },
        "refreshUrl": {
          "type": "string"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "PasswordOAuthFlow": {
      "type": "object",
      "properties": {
        "tokenUrl": {
          "type": "string"
        },
        "refreshUrl": {
          "type": "string"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DeviceCodeOAuthFlow": {
      "type": "object",
      "properties": {
        "deviceAuthorizationUrl": {
          "type": "string"
        },
        "tokenUrl": {
          "type": "string"
        },
        "refreshUrl": {
          "type": "string"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "deviceAuthorizationUrl",
        "tokenUrl",
        "scopes"
      ]
    },
    "OpenIdConnectSecurityScheme": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "openIdConnectUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "openIdConnectUrl"
      ]
    },
    "MutualTlsSecurityScheme": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SecurityRequirement": {
      "type": "object",
      "properties": {
        "schemes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StringList"
          }
        }
      },
      "additionalProperties": false
    },
    "StringList": {
      "type": "object",
      "properties": {
        "list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "AgentSkill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "securityRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecurityRequirement"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "tags"
      ]
    },
    "AgentCardSignature": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "header": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "protected",
        "signature"
      ]
    }
  }
}
