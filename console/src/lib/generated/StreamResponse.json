{
  "$ref": "#/$defs/StreamResponse",
  "$defs": {
    "StreamResponse": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/Task"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "statusUpdate": {
          "$ref": "#/$defs/TaskStatusUpdateEvent"
        },
        "artifactUpdate": {
          "$ref": "#/$defs/TaskArtifactUpdateEvent"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "task"
              ]
            },
            {
              "required": [
                "message"
              ]
            },
            {
              "required": [
                "statusUpdate"
              ]
            },
            {
              "required": [
                "artifactUpdate"
              ]
            }
          ]
        }
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ]
    },
    "TaskStatus": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "TASK_STATE_UNSPECIFIED",
            "TASK_STATE_SUBMITTED",
            "TASK_STATE_WORKING",
            "TASK_STATE_COMPLETED",
            "TASK_STATE_FAILED",
            "TASK_STATE_CANCELED",
            "TASK_STATE_INPUT_REQUIRED",
            "TASK_STATE_REJECTED",
            "TASK_STATE_AUTH_REQUIRED"
          ]
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "ROLE_UNSPECIFIED",
            "ROLE_USER",
            "ROLE_AGENT"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "referenceTaskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "messageId",
        "role",
        "parts"
      ]
    },
    "Part": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "raw": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "data": {
          "tsType": "unknown"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "filename": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "raw"
              ]
            },
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "data"
              ]
            }
          ]
        }
      ]
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "parts"
      ]
    },
    "TaskStatusUpdateEvent": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "taskId",
        "contextId",
        "status"
      ]
    },
    "TaskArtifactUpdateEvent": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "append": {
          "type": "boolean"
        },
        "lastChunk": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "taskId",
        "contextId",
        "artifact"
      ]
    }
  }
}
