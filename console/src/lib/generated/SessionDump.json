    "TaskData": {
      "description": "The `data` column: the A2A `Task` fields a row keeps, as v1 protobuf JSON; an absent field is\nleft out.",
      "properties": {
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "artifacts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Artifact"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "status_message": {
          "anyOf": [
