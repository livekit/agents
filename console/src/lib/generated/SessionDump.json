              "$ref": "#/$defs/Message"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "TaskRow": {
      "description": "One A2A task of a lane. The A2A `Task` is\n`id = task_id`, `contextId = the thread id`, `status = (status, data.statusMessage, updated_at)`,\nplus the fields of `data`.",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "submitted",
            "working",
            "input-required",
            "completed",
            "failed",
            "canceled",
            "rejected"
          ],
          "type": "string"
        },
        "updated_at": {
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/TaskData"
        },
        "ask": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ask"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task_id",
        "lane",
        "seq",
        "name",
        "message_id",
        "status",
        "updated_at",
        "data",
        "ask"
      ],
      "type": "object"
    },
