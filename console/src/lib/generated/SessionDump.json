    "EventRow": {
      "description": "One journal entry: every `AgentSessionEvent`, plus `run_started` and `run_ended`, tagged with\nthe lane. Append-only, owned by the framework.",
      "properties": {
        "id": {
          "type": "integer"
        },
        "ts_ms": {
          "type": "integer"
        },
        "lane": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "payload": {}
      },
      "required": [
        "id",
        "ts_ms",
        "lane",
        "run_id",
        "type",
        "payload"
      ],
      "type": "object"
    },
    "FunctionCall": {
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "function_call",
          "default": "function_call",
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "created_at": {
          "type": "number"
        },
        "extra": {
          "additionalProperties": true,
          "type": "object"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "call_id",
        "arguments",
        "name",
        "type"
      ],
      "type": "object"
    },
    "FunctionCallOutput": {
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "function_call_output",
          "default": "function_call_output",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "created_at": {
          "type": "number"
        },
        "reply_required": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "call_id",
        "output",
        "is_error",
        "type"
      ],
      "type": "object"
    },
    "ImageContent": {
      "description": "ImageContent is used to input images into the ChatContext on supported LLM providers / plugins.\n\nYou may need to consult your LLM provider's documentation on supported URL types.\n\n```python\n# Pass a VideoFrame directly, which will be automatically converted to a JPEG data URL internally\nasync for event in rtc.VideoStream(video_track):\n    chat_image = ImageContent(image=event.frame)\n    # this instance is now available for your ChatContext\n\n# Encode your VideoFrame yourself for more control, and pass the result as a data URL (see EncodeOptions for more details)\nfrom livekit.agents.utils.images import encode, EncodeOptions, ResizeOptions\n\nimage_bytes = encode(\n    event.frame,\n    EncodeOptions(\n        format=\"PNG\",\n        resize_options=ResizeOptions(width=512, height=512, strategy=\"scale_aspect_fit\"),\n    ),\n)\nchat_image = ImageContent(\n    image=f\"data:image/png;base64,{base64.b64encode(image_bytes).decode('utf-8')}\"\n)\n\n# With an external URL\nchat_image = ImageContent(image=\"https://example.com/image.jpg\")\n```",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "image_content",
          "default": "image_content",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "properties": {
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "data": {
                  "type": "string"
                }
              },
              "required": [
                "width",
                "height",
                "type",
                "data"
              ],
              "type": "object"
            }
          ]
        },
        "inference_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inference_height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inference_detail": {
          "default": "auto",
          "enum": [
            "auto",
            "high",
            "low"
          ],
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "image",
        "type"
      ],
      "type": "object"
    },
