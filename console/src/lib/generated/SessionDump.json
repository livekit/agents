    "ChatMessage": {
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "message",
          "default": "message",
          "type": "string"
        },
        "role": {
          "enum": [
            "developer",
            "system",
            "user",
            "assistant"
          ],
